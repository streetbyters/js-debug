{
  "name": "@streetbyters/js-debug",
  "version": "0.1.3",
  "description": "Simple, practical Javascript|NodeJS Debug Logging",
  "keywords": [
    "debug",
    "javascript",
    "logging",
    "nodejs"
  ],
  "homepage": "https://github.com/streetbyters/js-debug#readme",
  "bugs": {
    "url": "https://github.com/streetbyters/js-debug/issues"
  },
  "license": "MIT",
  "author": "Streetbyters Community <https://github.com/streetbyters>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/streetbyters/js-debug.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "lint": "oxlint --max-warnings 0 index.js test/security.test.js",
    "lint:fix": "oxlint --fix --max-warnings 0 index.js test/security.test.js",
    "format": "oxfmt --write index.js index.d.ts package.json .oxlintrc.json .oxfmtrc.json test/security.test.js",
    "test": "node --test",
    "format:check": "oxfmt --check index.js index.d.ts package.json .oxlintrc.json .oxfmtrc.json test/security.test.js"
  },
  "dependencies": {
    "moment": "^2.30.1"
  },
  "devDependencies": {
    "oxfmt": "^0.64.0",
    "oxlint": "^1.86.0"
  },
  "engines": {
    "node": ">= 20.19.5",
    "npm": ">= 9.6.7",
    "pnpm": ">= 10.18.0",
    "yarn": ">= 1.22.19"
  },
  "packageManager": "pnpm@10.28.0"
}
